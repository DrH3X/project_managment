# Configuration du serveur
PORT=4000

# Connexion à MongoDB
MONGODB_URI=mongodb://localhost:27017/plateforme

# Secret JWT (OBLIGATOIRE en production : remplacez cette valeur)
JWT_SECRET=changez-moi-en-production

# Durée de validité du jeton
JWT_EXPIRES_IN=8h

# Origine autorisée par CORS (URL du front-end Next.js)
FRONTEND_URL=http://localhost:3000

# Environnement
NODE_ENV=development
