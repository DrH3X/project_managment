# URL de base de l'API back-end (sans le slash final).
# Par défaut, l'API tourne sur le port 4000 avec le préfixe /api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# (Optionnel — prévisualisation locale via la passerelle)
# Si cette variable est définie, chaque requête Axios reçoit le paramètre
# d'URL `XTransformPort=<valeur>` afin de router l'appel vers un autre port
# via la passerelle. Laisser vide en production / pour l'API réelle sur le port 4000.
# NEXT_PUBLIC_API_TRANSFORM_PORT=
